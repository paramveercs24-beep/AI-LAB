import heapq

def manhattan(state, goal):
    distance = 0
    for i in range(9):
        if state[i] != 0:
            a = state.index(state[i])
            b = goal.index(state[i])
            distance += abs(a // 3 - b // 3) + abs(a % 3 - b % 3)
    return distance


def successors(state):
    result = []
    zero = state.index(0)
    row, col = zero // 3, zero % 3

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        nr, nc = row + dr, col + dc

        if 0 <= nr < 3 and 0 <= nc < 3:
            new_zero = nr * 3 + nc
            new_state = list(state)
            new_state[zero], new_state[new_zero] = \
                new_state[new_zero], new_state[zero]
            result.append(tuple(new_state))

    return result


def a_star(initial, goal):
    open_list = []
    closed = set()
    parent = {initial: None}
    g = {initial: 0}

    f = manhattan(initial, goal)
    heapq.heappush(open_list, (f, 0, initial))

    while open_list:
        _, _, current = heapq.heappop(open_list)

        if current in closed:
            continue

        if current == goal:
            path = []
            while current is not None:
                path.append(current)
                current = parent[current]
            return path[::-1]

        closed.add(current)

        for next_state in successors(current):
            new_g = g[current] + 1

            if next_state in closed:
                continue

            if next_state not in g or new_g < g[next_state]:
                g[next_state] = new_g
                parent[next_state] = current
                h = manhattan(next_state, goal)
                f = new_g + h
                heapq.heappush(open_list, (f, new_g, next_state))

    return None


initial = (
    1, 2, 3,
    4, 0, 6,
    7, 5, 8
)

goal = (
    1, 2, 3,
    4, 5, 6,
    7, 8, 0
)

path = a_star(initial, goal)

if path:
    print("Solution Found")
    print("Moves:", len(path) - 1)

    for i, state in enumerate(path):
        print("Step", i)
        for j in range(0, 9, 3):
            print(state[j], state[j + 1], state[j + 2])
        print()
else:
    print("Solution Not Found")

